{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wheel-mcp production run manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "caseId",
    "taskId",
    "gateId",
    "source",
    "environment",
    "commands",
    "inputSnapshotHash",
    "startedAt",
    "finishedAt",
    "durationMs",
    "testDouble",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "pattern": "^T[0-9]{2}$" },
    "gateId": { "type": "string", "pattern": "^G[0-6]$" },
    "source": { "type": "object", "required": ["head", "sourceHash", "files", "diffHash", "lockHash"] },
    "environment": { "type": "object", "required": ["node", "os", "godot", "renderer"] },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "argv", "required", "status", "exitCode", "signal", "durationMs", "outputHash"]
      }
    },
    "inputSnapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "number", "minimum": 0 },
    "testDouble": { "enum": ["REAL", "MOCK", "MIXED"] },
    "evidence": { "type": "array" }
  }
}
