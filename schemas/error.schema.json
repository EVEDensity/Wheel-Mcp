{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wheel-mcp.invalid/schemas/error.schema.json",
  "type": "object",
  "required": ["schema_version", "source", "status", "code", "message", "retryable", "timed_out"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "source": { "const": "REAL" },
    "status": { "const": "FAIL" },
    "code": { "type": "string", "minLength": 1 },
    "message": { "type": "string" },
    "retryable": { "type": "boolean" },
    "timed_out": { "type": "boolean" },
    "details": {}
  },
  "additionalProperties": true
}
