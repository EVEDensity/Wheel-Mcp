{
  "name": "godot-game-harness-mcp",
  "version": "0.1.0-preview.1",
  "private": false,
  "type": "module",
  "description": "CLI-first Godot runtime adapter for AI Game Harness.",
  "license": "MIT",
  "bin": {
    "godot-harness": "build/src/cli.js",
    "godot-harness-mcp": "build/src/mcp-server-sdk.js",
    "godot-harness-mcp-http": "build/src/mcp-http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/src/cli.js doctor",
    "test": "npm run build && node --test build/tests/*.test.js",
    "format": "prettier --write src tests godot-plugin *.json",
    "format:check": "prettier --check src tests godot-plugin *.json",
    "lint": "eslint src tests",
    "check": "npm run build && npm run format:check && npm run lint && node --test build/tests/*.test.js",
    "release:check": "node scripts/release-check.mjs",
    "sbom": "npm sbom --sbom-format=cyclonedx",
    "audit:dependencies": "npm audit --audit-level=high",
    "security:check": "npm run audit:dependencies && npm run sbom",
    "matrix:generate": "node scripts/generate-matrix.mjs",
    "mcp:http": "node build/src/mcp-http-server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "^22.10.1",
    "eslint": "9.39.5",
    "prettier": "3.5.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "yaml": "2.9.1"
  }
}
