{
  "name": "wheel-mcp",
  "version": "0.2.7",
  "wheelReleaseProfile": "windows-local",
  "private": false,
  "type": "module",
  "description": "Wheel-mcp: Godot runtime MCP server and CLI for AI-assisted game development.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EVEDensity/Wheel-Mcp.git"
  },
  "homepage": "https://evedensity.github.io/Wheel-Mcp/",
  "bugs": {
    "url": "https://github.com/EVEDensity/Wheel-Mcp/issues"
  },
  "files": [
    "build/src/**/*.js",
    "godot-plugin/**/*.gd",
    "godot-plugin/**/plugin.cfg",
    "scripts/install.mjs",
    "scripts/setup.mjs",
    "scripts/run-mcp.mjs",
    "scripts/lib/project-root.mjs",
    "scripts/lib/godot-discovery.mjs",
    "scripts/lib/platform-paths.mjs",
    "scripts/lib/mcp-hosts.mjs",
    "scripts/lib/codex-config.mjs",
    "README.zh-CN.md",
    "SECURITY.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "bin": {
    "wheel-mcp-cli": "build/src/cli.js",
    "wheel-mcp": "build/src/mcp-server-sdk.js",
    "wheel-mcp-http": "build/src/mcp-http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "go": "node scripts/install.mjs",
    "go:global": "node scripts/install.mjs --global",
    "setup": "node scripts/setup.mjs",
    "setup:global": "node scripts/setup.mjs --global --force",
    "install:mcp": "node scripts/setup.mjs --force",
    "prepack": "npm run build",
    "mcp": "node scripts/run-mcp.mjs",
    "start": "node build/src/cli.js doctor",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test --test-concurrency=2 build/tests/*.test.js",
    "test:ci-fast": "node scripts/test-ci-fast.mjs",
    "test:package": "npm run build && node --test build/tests/package-distribution.test.js",
    "test:godot-ci": "npm run build && node scripts/test-godot-ci.mjs",
    "verify:roadmap": "node scripts/check-roadmap.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "baseline:defects": "npm run build && node tests/production-baseline/run.mjs",
    "format": "prettier --write src tests godot-plugin *.json",
    "format:check": "prettier --check src tests godot-plugin *.json",
    "lint": "eslint src tests",
    "check": "npm run build && npm run format:check && npm run lint && npm run test:ci-fast",
    "check:full": "npm run build && npm run format:check && npm run lint && npm run test:built",
    "release:check": "node scripts/check-local-release.mjs",
    "release:check:production": "node scripts/release-check.mjs",
    "release:gate": "node scripts/release-gate-local.mjs",
    "release:gate:full": "node scripts/release-gate-full.mjs",
    "sbom": "npm sbom --sbom-format=cyclonedx",
    "audit:dependencies": "npm audit --audit-level=high",
    "security:check": "npm run audit:dependencies && npm run sbom",
    "matrix:generate": "node scripts/generate-matrix.mjs",
    "mcp:http": "node build/src/mcp-http-server.js",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:comparison": "npm run build && node scripts/efficiency-comparison.mjs",
    "benchmark:repair": "npm run build && node scripts/repair-benchmark.mjs",
    "benchmark:historical": "npm run build && node scripts/historical-repair-benchmark.mjs",
    "benchmark:shutdown": "npm run build && node scripts/strict-shutdown-benchmark.mjs",
    "benchmark:client-repair-rpg": "npm run build && node scripts/client-repair-rpg.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "site:test": "node --test scripts/site.test.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "ip-address": "10.7.4",
    "proxy-addr": "2.0.8",
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.10.1",
    "adm-zip": "^0.6.1",
    "eslint": "10.10.0",
    "prettier": "3.5.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "fast-uri": "3.1.8",
    "ip-address": "10.7.4",
    "proxy-addr": "2.0.8",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  }
}
